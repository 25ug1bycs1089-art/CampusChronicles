# Backend environment variables for Campus Chronicles
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# --- JWT Authentication ---
# Use a long, random, high-entropy string in production (e.g. openssl rand -hex 64)
JWT_SECRET=

# --- CORS: Allowed Frontend Origin ---
# Development: http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# --- Cloudinary (image uploads) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Find this in Cloudinary Dashboard → Settings → API Keys → SDK Credentials
# NEVER expose this variable to the frontend or commit it to source control.
CLOUDINARY_URL=
